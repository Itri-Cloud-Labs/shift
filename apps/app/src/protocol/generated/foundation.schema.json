{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shift:foundation:1",
  "title": "FoundationPayload",
  "anyOf": [
    {
      "$ref": "#/$defs/ServerInfo"
    },
    {
      "$ref": "#/$defs/ServerHealth"
    },
    {
      "$ref": "#/$defs/ProtocolError"
    },
    {
      "$ref": "#/$defs/ShutdownAcknowledgement"
    },
    {
      "$ref": "#/$defs/ServerIdentity"
    },
    {
      "$ref": "#/$defs/Device"
    },
    {
      "$ref": "#/$defs/PairRequest"
    },
    {
      "$ref": "#/$defs/PairResponse"
    },
    {
      "$ref": "#/$defs/PairingIssued"
    },
    {
      "$ref": "#/$defs/DeviceList"
    },
    {
      "$ref": "#/$defs/DeviceResponse"
    },
    {
      "$ref": "#/$defs/Project"
    },
    {
      "$ref": "#/$defs/Workflow"
    },
    {
      "$ref": "#/$defs/Run"
    },
    {
      "$ref": "#/$defs/Interaction"
    },
    {
      "$ref": "#/$defs/Workspace"
    },
    {
      "$ref": "#/$defs/CommandReceipt"
    },
    {
      "$ref": "#/$defs/ProjectResponse"
    },
    {
      "$ref": "#/$defs/WorkflowResponse"
    },
    {
      "$ref": "#/$defs/WorkflowVersionResponse"
    },
    {
      "$ref": "#/$defs/RunResponse"
    },
    {
      "$ref": "#/$defs/InteractionResponse"
    },
    {
      "$ref": "#/$defs/WorkspaceResponse"
    },
    {
      "$ref": "#/$defs/CommandReceiptResponse"
    },
    {
      "$ref": "#/$defs/ProjectList"
    },
    {
      "$ref": "#/$defs/WorkflowList"
    },
    {
      "$ref": "#/$defs/RunList"
    },
    {
      "$ref": "#/$defs/InteractionList"
    },
    {
      "$ref": "#/$defs/WorkspaceList"
    },
    {
      "$ref": "#/$defs/ExecutionPage"
    },
    {
      "$ref": "#/$defs/Event"
    },
    {
      "$ref": "#/$defs/EventPage"
    },
    {
      "$ref": "#/$defs/Snapshot"
    }
  ],
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36
    },
    "Timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epochMs", "iso"],
      "properties": {
        "epochMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "iso": {
          "type": "string",
          "format": "date-time",
          "maxLength": 32
        }
      }
    },
    "ServerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverId", "eventEpoch"],
      "properties": {
        "serverId": {
          "$ref": "#/$defs/Uuid"
        },
        "eventEpoch": {
          "$ref": "#/$defs/Uuid"
        }
      }
    },
    "Readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "phase", "reason"],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "phase": {
          "enum": ["starting", "ready", "stopping", "failed"]
        },
        "reason": {
          "enum": ["STARTING", "READY", "STOPPING", "PERSISTENCE_UNAVAILABLE"]
        }
      },
      "oneOf": [
        {
          "properties": {
            "ready": {
              "const": false
            },
            "phase": {
              "const": "starting"
            },
            "reason": {
              "const": "STARTING"
            }
          }
        },
        {
          "properties": {
            "ready": {
              "const": true
            },
            "phase": {
              "const": "ready"
            },
            "reason": {
              "const": "READY"
            }
          }
        },
        {
          "properties": {
            "ready": {
              "const": false
            },
            "phase": {
              "const": "stopping"
            },
            "reason": {
              "const": "STOPPING"
            }
          }
        },
        {
          "properties": {
            "ready": {
              "const": false
            },
            "phase": {
              "const": "failed"
            },
            "reason": {
              "const": "PERSISTENCE_UNAVAILABLE"
            }
          }
        }
      ]
    },
    "ProtocolRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "ServerCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "events", "pairing", "nodeTypes", "harnesses"],
      "properties": {
        "commands": {
          "type": "boolean"
        },
        "events": {
          "type": "boolean"
        },
        "pairing": {
          "type": "boolean"
        },
        "nodeTypes": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 0
        },
        "harnesses": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 0
        }
      }
    },
    "ServerInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "serverId",
        "eventEpoch",
        "serverVersion",
        "protocol",
        "readiness",
        "capabilities",
        "time"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/Uuid"
        },
        "serverId": {
          "$ref": "#/$defs/Uuid"
        },
        "eventEpoch": {
          "$ref": "#/$defs/Uuid"
        },
        "serverVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolRange"
        },
        "readiness": {
          "$ref": "#/$defs/Readiness"
        },
        "capabilities": {
          "$ref": "#/$defs/ServerCapabilities"
        },
        "time": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "ServerHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "serverId",
        "eventEpoch",
        "protocol",
        "liveness",
        "readiness",
        "time"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/Uuid"
        },
        "serverId": {
          "$ref": "#/$defs/Uuid"
        },
        "eventEpoch": {
          "$ref": "#/$defs/Uuid"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolRange"
        },
        "liveness": {
          "const": "alive"
        },
        "readiness": {
          "$ref": "#/$defs/Readiness"
        },
        "time": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "message"],
      "properties": {
        "field": {
          "type": "string",
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "ProtocolError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "code", "message", "retryable", "diagnostics"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/Uuid"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "message": {
          "type": "string",
          "maxLength": 512
        },
        "retryable": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "maxItems": 32
        }
      }
    },
    "ShutdownAcknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "accepted"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/Uuid"
        },
        "accepted": {
          "const": true
        }
      }
    },
    "DeviceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "CommandId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,100}$"
    },
    "Device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "createdAt", "lastSeenAt", "revokedAt"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "name": {
          "$ref": "#/$defs/DeviceName"
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "lastSeenAt": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "revokedAt": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "PairRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phrase", "deviceName", "commandId"],
      "properties": {
        "phrase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "deviceName": {
          "$ref": "#/$defs/DeviceName"
        },
        "commandId": {
          "$ref": "#/$defs/CommandId"
        }
      }
    },
    "PairResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "device", "token"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/Uuid"
        },
        "device": {
          "$ref": "#/$defs/Device"
        },
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "PairingIssued": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "pairing"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/Uuid"
        },
        "pairing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phrase", "expiresAt"],
          "properties": {
            "phrase": {
              "type": "string",
              "pattern": "^[a-z]+( [a-z]+){7}$"
            },
            "expiresAt": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "DeviceList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "devices", "currentDeviceId"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/Uuid"
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Device"
          },
          "maxItems": 1000
        },
        "currentDeviceId": {
          "$ref": "#/$defs/Uuid"
        }
      }
    },
    "DeviceResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "device"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/Uuid"
        },
        "device": {
          "$ref": "#/$defs/Device"
        }
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "repositoryPath", "baseRef", "createdAt"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "repositoryPath": {
          "type": "string",
          "maxLength": 4096
        },
        "baseRef": {
          "type": "string",
          "maxLength": 256
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "WorkflowSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "projectId", "name", "activeVersionId"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "projectId": {
          "$ref": "#/$defs/Uuid"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "activeVersionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "name",
        "enabled",
        "draftRevision",
        "draft",
        "activeVersionId",
        "versions",
        "createdAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "projectId": {
          "$ref": "#/$defs/Uuid"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "enabled": {
          "type": "boolean"
        },
        "draftRevision": {
          "type": "integer",
          "minimum": 0
        },
        "draft": {
          "type": "object"
        },
        "activeVersionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "number", "hash", "createdAt"],
            "properties": {
              "id": {
                "$ref": "#/$defs/Uuid"
              },
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "createdAt": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "maxItems": 100000
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "state", "error"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "PENDING",
            "RUNNING",
            "WAITING",
            "COMPLETED",
            "FAILED",
            "INTERRUPTED",
            "CANCELLED"
          ]
        },
        "error": {}
      }
    },
    "Execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "node",
        "type",
        "sequence",
        "state",
        "port",
        "predecessorId",
        "connectionId",
        "sources",
        "output",
        "error",
        "attempts"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "node": {
          "type": "string",
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "maxLength": 200
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": ["PENDING", "RUNNING", "WAITING", "COMPLETED", "FAILED", "CANCELLED"]
        },
        "port": {
          "type": ["string", "null"],
          "maxLength": 100
        },
        "predecessorId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "connectionId": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "sources": {
          "type": ["object", "null"]
        },
        "output": {},
        "error": {},
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attempt"
          },
          "maxItems": 1000
        }
      }
    },
    "RunSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "workflowId", "createdAt", "finishedAt"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "state": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "WAITING",
            "HELD",
            "NEEDS_HUMAN",
            "FAILED",
            "CANCEL_REQUESTED",
            "CANCELLED",
            "COMPLETED"
          ]
        },
        "workflowId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "finishedAt": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "workflowId",
        "versionId",
        "versionNumber",
        "repository",
        "baseCommit",
        "workspace",
        "attention",
        "wait",
        "activeTime",
        "cancelRequested",
        "outcome",
        "createdAt",
        "finishedAt",
        "executions",
        "invocations",
        "controls"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "state": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "WAITING",
            "HELD",
            "NEEDS_HUMAN",
            "FAILED",
            "CANCEL_REQUESTED",
            "CANCELLED",
            "COMPLETED"
          ]
        },
        "workflowId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "versionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "versionNumber": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "repository": {
          "type": "string",
          "maxLength": 4096
        },
        "baseCommit": {
          "type": ["string", "null"],
          "maxLength": 64
        },
        "workspace": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "path", "state"],
              "properties": {
                "id": {
                  "$ref": "#/$defs/Uuid"
                },
                "path": {
                  "type": ["string", "null"],
                  "maxLength": 4096
                },
                "state": {
                  "type": ["string", "null"],
                  "maxLength": 20
                }
              }
            }
          ]
        },
        "attention": {
          "type": ["object", "null"]
        },
        "wait": {
          "type": ["object", "null"]
        },
        "activeTime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["usedMs", "limitMs"],
          "properties": {
            "usedMs": {
              "type": "integer",
              "minimum": 0
            },
            "limitMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "outcome": {},
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "finishedAt": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "executions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Execution"
          },
          "maxItems": 100000
        },
        "invocations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "state",
              "correlationId",
              "submissions",
              "acceptedSubmissions"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/Uuid"
              },
              "kind": {
                "enum": ["goal", "correction", "continuation"]
              },
              "state": {
                "type": "string",
                "maxLength": 20
              },
              "correlationId": {
                "type": "string",
                "maxLength": 200
              },
              "submissions": {
                "type": "integer",
                "minimum": 0
              },
              "acceptedSubmissions": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "maxItems": 100000
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "executionId", "actor", "payload", "createdAt"],
            "properties": {
              "id": {
                "$ref": "#/$defs/Uuid"
              },
              "kind": {
                "enum": ["cancel", "retry", "fail", "complete", "extend"]
              },
              "executionId": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "actor": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "id"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "id": {
                    "type": "string",
                    "maxLength": 100
                  }
                }
              },
              "payload": {},
              "createdAt": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "maxItems": 100000
        }
      }
    },
    "Interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "runId",
        "executionId",
        "node",
        "kind",
        "state",
        "revision",
        "title",
        "instructions",
        "form",
        "outcomes",
        "expiresAt",
        "createdAt",
        "settledAt",
        "runState",
        "response"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "runId": {
          "$ref": "#/$defs/Uuid"
        },
        "executionId": {
          "$ref": "#/$defs/Uuid"
        },
        "node": {
          "type": "string",
          "maxLength": 200
        },
        "kind": {
          "enum": ["input", "approval"]
        },
        "state": {
          "enum": ["PENDING", "RESPONDED", "EXPIRED", "CANCELLED"]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "instructions": {
          "type": ["string", "null"],
          "maxLength": 20000
        },
        "form": {
          "type": "object"
        },
        "outcomes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40
              },
              "maxItems": 10
            }
          ]
        },
        "expiresAt": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "settledAt": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "runState": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "WAITING",
            "HELD",
            "NEEDS_HUMAN",
            "FAILED",
            "CANCEL_REQUESTED",
            "CANCELLED",
            "COMPLETED"
          ]
        },
        "response": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["decision", "data", "actor", "createdAt"],
              "properties": {
                "decision": {
                  "type": ["string", "null"],
                  "maxLength": 40
                },
                "data": {},
                "actor": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "id"],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "maxLength": 20
                    },
                    "id": {
                      "type": "string",
                      "maxLength": 100
                    }
                  }
                },
                "createdAt": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        }
      }
    },
