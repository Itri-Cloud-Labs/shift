{
  "name": "@shift/monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @shift/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm format:check && pnpm protocol:check && pnpm typecheck && pnpm --filter @shift/app build && pnpm test",
    "format": "prettier --write apps .github \"*.json\" \"*.yaml\" README.md \"docs/implementation-*.md\"",
    "format:check": "prettier --check apps .github \"*.json\" \"*.yaml\" README.md \"docs/implementation-*.md\"",
    "protocol:generate": "pnpm --filter @shift/server protocol:generate",
    "protocol:check": "pnpm --filter @shift/server protocol:check",
    "app:dev": "pnpm --filter @shift/app dev",
    "app:package": "pnpm --filter @shift/app package",
    "app:smoke": "pnpm --filter @shift/app smoke"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
